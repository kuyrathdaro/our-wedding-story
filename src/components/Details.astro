---
// Details.astro - Event Schedule & Custom Map Layout (Bilingual)
---
<section id="details" class="details-section">
  <div class="details-container">
    <div class="section-header reveal-on-scroll">
      <span class="section-subtitle">
        <span class="lang-kh">ពេលវេលា និងទីតាំង</span>
        <span class="lang-en">The Big Day</span>
      </span>
      <h2 class="section-title khmer-title lang-kh">ព័ត៌មានលម្អិតនៃកម្មវិធី</h2>
      <h2 class="section-title english-title lang-en">Wedding Details</h2>
      
      <!-- Custom Khmer traditional Kbach border decoration -->
      <div class="khmer-ornament-divider">
        <svg width="140" height="24" viewBox="0 0 140 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 12 L50 12 M130 12 L90 12" stroke="var(--accent-gold)" stroke-width="1"/>
          <circle cx="10" cy="12" r="2.5" fill="var(--accent-gold)"/>
          <circle cx="130" cy="12" r="2.5" fill="var(--accent-gold)"/>
          <path d="M70 2 C73 7 73 17 70 22 C67 17 67 7 70 2 Z" fill="var(--accent-gold)"/>
          <path d="M70 6 C75 9 75 15 70 18 C65 15 65 9 70 6 Z" fill="none" stroke="var(--bg-secondary)" stroke-width="0.75"/>
          <path d="M62 12 C58 8 54 8 53 12 C54 16 58 16 62 12 Z" fill="var(--accent-gold)"/>
          <path d="M78 12 C82 8 86 8 87 12 C86 16 82 16 78 12 Z" fill="var(--accent-gold)"/>
        </svg>
      </div>

      <p class="section-intro khmer-text lang-kh">ព័ត៌មានលម្អិតអំពីពេលវេលា ទីកន្លែងកម្មវិធីមង្គលការ និងរបៀបរបបសម្លៀកបំពាក់សម្រាប់ការចូលរួម។</p>
      <p class="section-intro english-text lang-en">Everything you need to know about the schedule, location, and dress code for our celebration.</p>
    </div>

    <div class="details-grid">
      <!-- Column 1: Schedule -->
      <div class="details-card schedule-card reveal-on-scroll">
        <h3 class="card-title">
          <span class="card-title-khmer lang-kh">កម្មវិធីមង្គលការ</span>
          <span class="card-title-english lang-en">Schedule of Events</span>
        </h3>
        
        <div class="timeline-small">
          <!-- Item 1: Arrival -->
          <div class="timeline-small-item">
            <div class="time">3:00 PM</div>
            <div class="event-details">
              <h4 class="event-name">
                <span class="event-khmer lang-kh">ការទទួលស្វាគមន៍ភ្ញៀវកិត្តិយស</span>
                <span class="event-english lang-en">Guest Arrival</span>
              </h4>
              <p class="event-desc">
                <span class="desc-khmer lang-kh">ទទួលស្វាគមន៍ភ្ញៀវកិត្តិយស និងពិសាភេសជ្ជៈសម្រន់ក្នុងសាលស្វាគមន៍។</span>
                <span class="desc-english lang-en">Welcome refreshments served in the main lobby.</span>
              </p>
            </div>
          </div>
          
          <!-- Item 2: Ceremony -->
          <div class="timeline-small-item">
            <div class="time">3:30 PM</div>
            <div class="event-details">
              <h4 class="event-name">
                <span class="event-khmer lang-kh">ពិធីកាត់សក់បង្កក់សិរី និងចងដៃសំពះ</span>
                <span class="event-english lang-en">Wedding Ceremony</span>
              </h4>
              <p class="event-desc">
                <span class="desc-khmer lang-kh">ពិធីកាត់សក់បង្កក់សិរី និងចងដៃសំពះការសុំពរជ័យពីចាស់ទុំនៅទីធ្លាសួនច្បារ។</span>
                <span class="desc-english lang-en">Traditional Hair-Cutting & Knot-Tying Ceremony on the lawn.</span>
              </p>
            </div>
          </div>
          
          <!-- Item 3: Cocktail -->
          <div class="timeline-small-item">
            <div class="time">4:30 PM</div>
            <div class="event-details">
              <h4 class="event-name">
                <span class="event-khmer lang-kh">ពិធីពិសាភេសជ្ជៈទទួលភ្ញៀវ</span>
                <span class="event-english lang-en">Cocktail Hour</span>
              </h4>
              <p class="event-desc">
                <span class="desc-khmer lang-kh">ការពិសាភេសជ្ជៈ និងអាហារសម្រន់លើវាលស្មៅ និងថតរូបអនុស្សាវរីយ៍។</span>
                <span class="desc-english lang-en">Signature cocktails & appetizers on the terrace.</span>
              </p>
            </div>
          </div>
          
          <!-- Item 4: Dinner -->
          <div class="timeline-small-item">
            <div class="time">6:00 PM</div>
            <div class="event-details">
              <h4 class="event-name">
                <span class="event-khmer lang-kh">ពិធីជប់លៀងអាហារពេលល្ងាច</span>
                <span class="event-english lang-en">Dinner & Reception</span>
              </h4>
              <p class="event-desc">
                <span class="desc-khmer lang-kh">ការអញ្ជើញចូលតុ កាត់នំអាពាហ៍ពិពាហ៍ និងការពិសារអាហារពេលល្ងាច។</span>
                <span class="desc-english lang-en">Grand entry, dinner service, toasts, and cake cutting.</span>
              </p>
            </div>
          </div>
          
          <!-- Item 5: Dancing -->
          <div class="timeline-small-item">
            <div class="time">8:00 PM</div>
            <div class="event-details">
              <h4 class="event-name">
                <span class="event-khmer lang-kh">ការរាំកម្សាន្ត និងការរាំវង់ប្រពៃណី</span>
                <span class="event-english lang-en">Dancing & Festivities</span>
              </h4>
              <p class="event-desc">
                <span class="desc-khmer lang-kh">រាំលេងកម្សាន្តជាមួយតន្ត្រីសម័យ និងការរាំវង់ប្រពៃណីខ្មែររហូតដល់កណ្តាលអាធ្រាត្រ។</span>
                <span class="desc-english lang-en">Live music, traditional Ramvong, and dancing until midnight.</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Column 2: Venue & Custom SVG Map -->
      <div class="details-card venue-card reveal-on-scroll">
        <h3 class="card-title">
          <span class="card-title-khmer lang-kh">ទីតាំងកម្មវិធី</span>
          <span class="card-title-english lang-en">The Venue</span>
        </h3>
        
        <div class="venue-info">
          <h4 class="venue-name">Sofitel Phnom Penh Phokeethra</h4>
          <p class="venue-address">26 Old August Site, Sothearos Blvd, Phnom Penh 120101</p>
          <div class="venue-note">
            <div class="note-khmer lang-kh">
              <p><strong>សម្លៀកបំពាក់៖</strong> សម្លៀកបំពាក់ប្រពៃណីខ្មែរ ឬឈុតធំសមរម្យ។ កម្មវិធីកាត់សក់នឹងធ្វើឡើងនៅទីធ្លាវាលស្មៅខាងក្រៅ ដូចនេះសូមភ្ញៀវកិត្តិយសជ្រើសរើសស្បែកជើងដែលងាយស្រួលដើរ។</p>
            </div>
            <div class="note-english lang-en">
              <p><strong>Dress Code:</strong> Traditional Khmer attire or Formal evening wear. The ceremony is outdoors, so please choose comfortable footwear.</p>
            </div>
          </div>
        </div>

        <!-- Custom SVG Estate Map -->
        <div class="map-layout-container">
          <div class="map-title">Estate Layout Map</div>
          <svg viewBox="0 0 400 250" class="estate-map-svg" width="100%" height="100%">
            <rect width="400" height="250" fill="var(--bg-primary)" rx="8" />
            <path d="M 0 0 L 400 250 M 400 0 L 0 250" stroke="rgba(197, 168, 128, 0.05)" stroke-width="1" />
            <path d="M 50 180 Q 120 200 200 130 T 350 70" fill="none" stroke="var(--accent-gold)" stroke-width="2" stroke-dasharray="4,4" />
            
            <!-- 1. Sunken Garden (Ceremony Area) -->
            <g class="map-zone" transform="translate(50, 150)">
              <circle cx="20" cy="20" r="30" fill="var(--bg-secondary)" stroke="var(--accent-gold)" stroke-width="1.5" />
              <circle cx="20" cy="20" r="24" fill="none" stroke="var(--accent-gold)" stroke-width="0.5" stroke-dasharray="2,2" />
              <circle cx="12" cy="15" r="2" fill="var(--accent-rose)" />
              <circle cx="28" cy="15" r="2" fill="var(--accent-rose)" />
              <circle cx="20" cy="28" r="2.5" fill="var(--accent-rose)" />
              <text x="20" y="-15" text-anchor="middle" font-family="var(--font-serif)" font-size="12" font-weight="600" fill="var(--text-primary)">Ceremony Lawn</text>
              <text x="20" y="4" text-anchor="middle" font-family="var(--font-sans)" font-size="8" fill="var(--text-secondary)">Sunken Garden</text>
            </g>

            <!-- 2. The Terrace (Cocktail Area) -->
            <g class="map-zone" transform="translate(180, 100)">
              <polygon points="20,0 50,15 35,45 5,30" fill="var(--bg-secondary)" stroke="var(--accent-gold)" stroke-width="1.5" />
              <text x="25" y="-12" text-anchor="middle" font-family="var(--font-serif)" font-size="12" font-weight="600" fill="var(--text-primary)">The Terrace</text>
              <text x="25" y="26" text-anchor="middle" font-family="var(--font-sans)" font-size="8" fill="var(--text-secondary)">Cocktails</text>
            </g>

            <!-- 3. Great Hall (Reception Area) -->
            <g class="map-zone" transform="translate(290, 40)">
              <rect x="-10" y="-10" width="70" height="50" fill="var(--bg-secondary)" stroke="var(--accent-gold)" stroke-width="1.5" rx="4" />
              <line x1="10" y1="-10" x2="10" y2="40" stroke="rgba(212, 175, 55, 0.3)" stroke-width="1" />
              <line x1="30" y1="-10" x2="30" y2="40" stroke="rgba(212, 175, 55, 0.3)" stroke-width="1" />
              <line x1="50" y1="-10" x2="50" y2="40" stroke="rgba(212, 175, 55, 0.3)" stroke-width="1" />
              <text x="25" y="-18" text-anchor="middle" font-family="var(--font-serif)" font-size="12" font-weight="600" fill="var(--text-primary)">Phokeethra Hall</text>
              <text x="25" y="20" text-anchor="middle" font-family="var(--font-sans)" font-size="8" fill="var(--text-secondary)">Dinner & Dance</text>
            </g>

            <!-- Legend/Compass -->
            <g transform="translate(360, 210)" stroke="var(--accent-gold)" stroke-width="1">
              <line x1="0" y1="-15" x2="0" y2="15" />
              <line x1="-15" y1="0" x2="15" y2="0" />
              <polygon points="0,-18 -4,-12 4,-12" fill="var(--accent-gold)" stroke="none" />
              <text x="0" y="-22" text-anchor="middle" font-family="var(--font-sans)" font-size="8" fill="var(--text-secondary)" stroke="none">N</text>
            </g>
          </svg>
        </div>

        <a href="https://maps.google.com/?q=Sofitel+Phnom+Penh+Phokeethra" target="_blank" rel="noopener noreferrer" class="btn-directions">
          <span class="lang-kh">មើលផែនទីទីតាំង</span>
          <span class="lang-en">Get Directions</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .details-section {
    padding: 120px 24px;
    background-color: var(--bg-primary);
  }

  .details-container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 80px auto;
  }

  .section-subtitle {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 12px;
  }

  .section-subtitle .lang-kh {
    font-family: var(--font-khmer-body);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: none;
  }

  .section-title {
    color: var(--text-primary);
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .section-title.khmer-title {
    font-family: var(--font-khmer-header);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .section-title.english-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .khmer-ornament-divider {
    margin: 16px auto 28px auto;
    display: flex;
    justify-content: center;
  }

  .section-intro {
    line-height: 1.7;
    margin: 0 auto;
    max-width: 620px;
  }

  .section-intro.khmer-text {
    font-family: var(--font-khmer-body);
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .section-intro.english-text {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  /* Grid details layout */
  .details-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

  .details-card {
    background-color: var(--bg-secondary);
    border-radius: 16px;
    padding: 48px;
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 40px rgba(0,0,0,0.02);
  }

  .card-title {
    display: flex;
    flex-direction: column;
    margin-bottom: 36px;
    position: relative;
    padding-bottom: 16px;
    line-height: 1.3;
  }

  .card-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 1.5px;
    background-color: var(--accent-gold);
  }

  .card-title-khmer {
    font-family: var(--font-khmer-header);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--text-primary);
  }

  .card-title-english {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--accent-gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Schedule layout style */
  .timeline-small {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .timeline-small-item {
    display: flex;
    gap: 24px;
    position: relative;
  }

  .timeline-small-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 85px;
    top: 24px;
    bottom: -32px;
    width: 1px;
    background-color: var(--border-color);
  }

  .time {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-red); /* Traditional Red time numbers */
    min-width: 80px;
    text-align: right;
    padding-top: 2px;
  }

  .event-details {
    flex: 1;
    text-align: left;
  }

  .event-name {
    display: flex;
    flex-direction: column;
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .event-khmer {
    font-family: var(--font-khmer-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .event-english {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--accent-gold);
  }

  .event-desc {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }

  .desc-khmer {
    font-family: var(--font-khmer-body);
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .desc-english {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Venue Card Styles */
  .venue-info {
    margin-bottom: 30px;
    text-align: left;
  }

  .venue-name {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    margin-bottom: 8px;
  }

  .venue-address {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .venue-note {
    background-color: var(--bg-primary);
    padding: 20px;
    border-radius: 8px;
    border-left: 3px solid var(--accent-red); /* Royal red border */
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .note-khmer {
    font-family: var(--font-khmer-body);
    font-size: 0.9rem;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.6;
  }

  .note-english {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* SVG Estate Map Styles */
  .map-layout-container {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 30px;
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.01);
  }

  .map-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-bottom: 16px;
    text-align: center;
    font-weight: 600;
  }

  .estate-map-svg {
    display: block;
    height: auto;
  }

  .map-zone {
    cursor: default;
    transition: var(--transition-smooth);
  }

  .map-zone:hover circle,
  .map-zone:hover polygon,
  .map-zone:hover rect {
    fill: var(--bg-primary);
    stroke: var(--text-primary);
    stroke-width: 2px;
  }

  .btn-directions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background-color: transparent;
    color: var(--text-primary);
    border: 1px solid var(--accent-gold);
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: var(--transition-smooth);
    box-shadow: 0 4px 10px rgba(0,0,0,0.01);
    align-self: flex-start;
  }

  .btn-directions span.lang-kh {
    font-family: var(--font-khmer-body);
    font-size: 0.82rem;
  }

  .btn-directions:hover {
    background-color: var(--accent-gold);
    color: var(--bg-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(197, 168, 128, 0.25);
  }

  /* Responsive Styling */
  @media (max-width: 992px) {
    .details-card {
      padding: 30px;
    }
  }

  @media (max-width: 768px) {
    .details-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .timeline-small-item:not(:last-child)::before {
      left: 75px;
    }

    .time {
      min-width: 70px;
    }
  }
</style>
