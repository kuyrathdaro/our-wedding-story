---
// Timeline.astro - Our Love Story Timeline (Bilingual)
import { getCloudinaryUrl } from '../utils/cloudinary';

const timelineEvents = [
  {
    id: 'v1781029920/story_meet_rzyoq8.jpg',
    alt: 'First Meet',
    dateKh: '១២ តុលា ២០២១',
    dateEn: 'October 12, 2021',
    titleKh: 'ការជួបគ្នាលើកដំបូង',
    titleEn: 'The First Meeting',
    textKh: 'វាបានចាប់ផ្តើមដោយការស្វាគមន៍យ៉ាងកក់ក្តៅ និងសាមញ្ញបំផុត។ យើងបានជួបគ្នានៅហាងកាហ្វេតូចមួយ ដែលការស្រឡាញ់សៀវភៅ និងរសជាតិកាហ្វេដូចគ្នា បានទាក់ទាញចិត្តយើងឱ្យជជែកគ្នាលេងអស់ជាច្រើនម៉ោងដោយភាពរីករាយក្រៃលែង និងដឹងថាយើងមាននិស្ស័យជាមួយគ្នា។',
    textEn: 'It all started with a simple hello. We crossed paths at a cozy local cafe where a shared love for books and warm coffee sparked an unexpected conversation that lasted for hours.'
  },
  {
    id: 'v1781029914/gallery_1_zxf2e1.jpg',
    alt: 'First Date',
    dateKh: '០៥ ធ្នូ ២០២១',
    dateEn: 'December 05, 2021',
    titleKh: 'ការណាត់ជួបដំបូង',
    titleEn: 'Our First Date',
    textKh: 'ការណាត់ជួបជាផ្លូវការដំបូងរបស់យើង គឺជាការដើរលំហែកាយយ៉ាងមនោរម្យនៅក្នុងសួនច្បារដែលពោរពេញទៅដោយពន្លឺថ្ងៃនាដូវស្លឹកឈើជ្រុះ។ ការដើរទន្ទឹមគ្នា ការចែករំលែកក្តីស្រមៃ និងការសើចសប្បាយជាមួយគ្នា ធ្វើឱ្យយើងដឹងថាមានអ្វីម្យ៉ាងកំពុងចាប់ផ្តើមរីកដុះដាលនៅក្នុងចិត្តរៀងៗខ្លួន។',
    textEn: 'Our first official date was a magical walk in a sun-drenched autumn park. Walking side-by-side on paths carpeted with golden leaves, sharing our dreams and laughing together, we felt an undeniable connection.'
  },
  {
    id: 'v1781029923/story_proposal_vawcup.jpg',
    alt: 'The Proposal',
    dateKh: '២១ មិថុនា ២០២៥',
    dateEn: 'June 21, 2025',
    titleKh: 'ការសុំរៀបការ',
    titleEn: 'The Proposal',
    textKh: 'ក្រោមពន្លឺព្រលប់ដ៏កក់ក្តៅ និងខ្សែភ្លើងលម្អយ៉ាងស្រស់ស្អាតលើកំពូលភ្នំដែលមើលទៅឃើញផ្ទៃសមុទ្រដ៏ធំល្វឹងល្វើយ ដារ៉ូបានសួរពាក្យស្នើសុំដ៏សំខាន់បំផុតក្នុងជីវិត។ កូនក្រមុំបានឆ្លើយយល់ព្រមទាំងទឹកភ្នែករំភើប និងស្នាមញញឹមដ៏មានសុភមង្គល។ វាជាការសម្រេចចិត្តដ៏ងាយស្រួល និងរីករាយបំផុត។',
    textEn: 'Under the warm twilight glow of fairy lights on a breathtaking clifftop overlooking the sea, Daro asked the question of a lifetime. Surrounded by the sound of waves and soft music, Bride said yes with tears of joy.'
  }
];
---
<section id="story" class="story-section">
  <div class="story-container">
    <div class="section-header reveal-on-scroll">
      <span class="section-subtitle">
        <span class="lang-kh">ដំណើរឆ្ពោះទៅកាន់ថ្ងៃអាពាហ៍ពិពាហ៍</span>
        <span class="lang-en">How It Started</span>
      </span>
      <h2 class="section-title khmer-title lang-kh">ដំណើររឿងរ៉ាវស្នេហា</h2>
      <h2 class="section-title english-title lang-en">Our Love Story</h2>
      
      <!-- Custom Khmer traditional Kbach border decoration -->
      <div class="khmer-ornament-divider">
        <svg width="140" height="24" viewBox="0 0 140 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 12 L50 12 M130 12 L90 12" stroke="var(--accent-gold)" stroke-width="1"/>
          <circle cx="10" cy="12" r="2.5" fill="var(--accent-gold)"/>
          <circle cx="130" cy="12" r="2.5" fill="var(--accent-gold)"/>
          <path d="M70 2 C73 7 73 17 70 22 C67 17 67 7 70 2 Z" fill="var(--accent-gold)"/>
          <path d="M70 6 C75 9 75 15 70 18 C65 15 65 9 70 6 Z" fill="none" stroke="var(--bg-secondary)" stroke-width="0.75"/>
          <path d="M62 12 C58 8 54 8 53 12 C54 16 58 16 62 12 Z" fill="var(--accent-gold)"/>
          <path d="M78 12 C82 8 86 8 87 12 C86 16 82 16 78 12 Z" fill="var(--accent-gold)"/>
        </svg>
      </div>

      <p class="section-intro khmer-text lang-kh">ខាងក្រោមនេះ គឺជាទិដ្ឋភាពខ្លះៗនៃដំណើរជីវិតគូរបស់យើងទាំងពីរ ចាប់តាំងពីថ្ងៃដំបូងដែលយើងបានជួបគ្នា រហូតដល់ថ្ងៃដែលយើងសម្រេចចិត្តរួមដំណើរជាមួយគ្នារហូតរៀងទៅ។</p>
      <p class="section-intro english-text lang-en">Here is a little glimpse into our journey from the moment we met to the day we decided to spend the rest of our lives together.</p>
    </div>

    <div class="timeline">
      <div class="timeline-line"></div>

      {timelineEvents.map((event) => (
        <div class="timeline-item reveal-on-scroll">
          <div class="timeline-img-container">
            <img src={getCloudinaryUrl(event.id, { width: 800 })} alt={event.alt} class="timeline-img" loading="lazy" />
          </div>
          <div class="timeline-content">
            <div class="timeline-date">
              <span class="lang-kh">{event.dateKh}</span>
              <span class="lang-en">{event.dateEn}</span>
            </div>
            <h3 class="timeline-title">
              <span class="lang-kh">{event.titleKh}</span>
              <span class="lang-en">{event.titleEn}</span>
            </h3>
            <p class="timeline-text">
              <span class="lang-kh">{event.textKh}</span>
              <span class="lang-en">{event.textEn}</span>
            </p>
          </div>
          <div class="timeline-dot"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initReveal() {
    const reveals = document.querySelectorAll('.reveal-on-scroll');
    
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    reveals.forEach(el => observer.observe(el));
  }

  // Initialize on page load
  initReveal();
</script>

<style>
  .story-section {
    padding: 120px 24px;
    background-color: var(--bg-primary);
    position: relative;
  }

  .story-container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 80px auto;
  }

  .section-subtitle {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 12px;
  }

  .section-subtitle .lang-kh {
    font-family: var(--font-khmer-body);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: none;
  }

  .section-title {
    color: var(--text-primary);
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .section-title.khmer-title {
    font-family: var(--font-khmer-header);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .section-title.english-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .section-intro {
    line-height: 1.7;
    margin: 0 auto;
    max-width: 620px;
  }

  .section-intro.khmer-text {
    font-family: var(--font-khmer-body);
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .section-intro.english-text {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  /* Timeline base */
  .timeline {
    position: relative;
    width: 100%;
    margin-top: 50px;
  }

  .timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background-color: var(--accent-red); /* Royal Red timeline line */
    transform: translateX(-50%);
    opacity: 0.3;
  }

  .timeline-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 80px;
    position: relative;
  }

  /* Alternating layout styling */
  .timeline-item:nth-child(even) {
    flex-direction: row-reverse;
  }

  .timeline-content, .timeline-img-container {
    width: 45%;
    position: relative;
  }

  .timeline-img-container {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border-color);
  }

  .timeline-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-item:hover .timeline-img {
    transform: scale(1.05);
  }

  .timeline-content {
    background-color: var(--bg-secondary);
    padding: 40px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    text-align: left;
  }

  .timeline-date {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-red); /* Crimson date color */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .timeline-date span.lang-kh {
    font-family: var(--font-khmer-body);
    font-size: 0.9rem;
    letter-spacing: 0;
  }

  .timeline-title {
    font-size: 1.8rem;
    color: var(--text-primary);
    margin-bottom: 16px;
    line-height: 1.3;
  }

  .timeline-title span.lang-kh {
    font-family: var(--font-khmer-header);
    font-size: 1.4rem;
    font-weight: normal;
  }

  .timeline-text {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .timeline-text span.lang-kh {
    font-family: var(--font-khmer-body);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .timeline-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--accent-gold); /* Gold dot */
    border: 4px solid var(--accent-red); /* Traditional Red border */
    transform: translate(-50%, -50%);
    z-index: 2;
    transition: var(--transition-smooth);
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.2);
  }

  .timeline-item:hover .timeline-dot {
    background-color: var(--accent-red);
    border-color: var(--accent-gold);
    box-shadow: 0 0 0 8px rgba(139, 30, 34, 0.2);
  }

  /* Reveal effects for timeline items */
  .timeline-item.reveal-on-scroll {
    opacity: 0;
  }
  
  /* Slide from left for odd, slide from right for even */
  .timeline-item.reveal-on-scroll:nth-child(odd) .timeline-content {
    transform: translateX(40px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .timeline-item.reveal-on-scroll:nth-child(odd) .timeline-img-container {
    transform: translateX(-40px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-item.reveal-on-scroll:nth-child(even) .timeline-content {
    transform: translateX(-40px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .timeline-item.reveal-on-scroll:nth-child(even) .timeline-img-container {
    transform: translateX(40px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-item.reveal-on-scroll.active {
    opacity: 1;
  }
  .timeline-item.reveal-on-scroll.active .timeline-content,
  .timeline-item.reveal-on-scroll.active .timeline-img-container {
    transform: translateX(0);
    opacity: 1;
  }

  /* Responsive styling */
  @media (max-width: 992px) {
    .timeline-content {
      padding: 30px;
    }
  }

  @media (max-width: 768px) {
    .timeline-line {
      left: 20px;
    }

    .timeline-item {
      flex-direction: column !important;
      align-items: flex-start;
      margin-bottom: 60px;
    }

    .timeline-content, .timeline-img-container {
      width: calc(100% - 40px);
      margin-left: 40px;
    }

    .timeline-img-container {
      margin-bottom: 24px;
      aspect-ratio: 16 / 10;
    }

    .timeline-dot {
      left: 20px;
      top: 24px;
    }

    .timeline-item.reveal-on-scroll .timeline-content,
    .timeline-item.reveal-on-scroll .timeline-img-container {
      transform: translateY(30px) !important;
    }
  }
</style>
