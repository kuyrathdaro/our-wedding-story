---
---
<header id="main-header" class="main-header">
  <div class="header-container">

    
    <nav class="nav-menu" id="nav-menu">
      <ul class="nav-list">
        <li>
          <a href="#home" class="nav-link">
            <span class="lang-kh">ទំព័រដើម</span>
            <span class="lang-en">Home</span>
          </a>
        </li>
        <li>
          <a href="#story" class="nav-link">
            <span class="lang-kh">ដំណើររឿងរ៉ាវ</span>
            <span class="lang-en">Our Story</span>
          </a>
        </li>
        <li>
          <a href="#gallery" class="nav-link">
            <span class="lang-kh">រូបភាពអនុស្សាវរីយ៍</span>
            <span class="lang-en">Gallery</span>
          </a>
        </li>
        <li>
          <a href="#details" class="nav-link">
            <span class="lang-kh">ព័ត៌មានលម្អិត</span>
            <span class="lang-en">Details</span>
          </a>
        </li>
        <li>
          <a href="#rsvp" class="nav-link btn-rsvp">
            <span class="lang-kh">ផ្ញើសារជូនពរ</span>
            <span class="lang-en">Wishes</span>
          </a>
        </li>
        <li class="lang-switcher-item">
          <div class="lang-switcher">
            <button type="button" class="lang-btn" data-set-lang="kh" aria-label="ភាសាខ្មែរ">ខ្មែរ</button>
            <span class="lang-divider">/</span>
            <button type="button" class="lang-btn" data-set-lang="en" aria-label="English">EN</button>
          </div>
        </li>
      </ul>
    </nav>
    
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const navToggle = document.getElementById('nav-toggle');
  const navMenu = document.getElementById('nav-menu');
  const navLinks = document.querySelectorAll('.nav-link');
  const langButtons = document.querySelectorAll('.lang-btn');

  // Add background glassmorphism class on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  // Toggle Mobile Menu
  navToggle?.addEventListener('click', () => {
    navToggle.classList.toggle('active');
    navMenu?.classList.toggle('active');
    header?.classList.toggle('menu-open');
    document.body.classList.toggle('no-scroll');
  });

  // Close mobile menu when a link is clicked
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      navToggle?.classList.remove('active');
      navMenu?.classList.remove('active');
      header?.classList.remove('menu-open');
      document.body.classList.remove('no-scroll');
    });
  });

  // Language Switcher Toggle logic
  function updateActiveLangButton() {
    const currentLang = document.documentElement.getAttribute('data-lang') || 'kh';
    langButtons.forEach(btn => {
      if (btn.getAttribute('data-set-lang') === currentLang) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  langButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const selectedLang = btn.getAttribute('data-set-lang');
      if (selectedLang) {
        document.documentElement.setAttribute('data-lang', selectedLang);
        localStorage.setItem('wedding-lang', selectedLang);
        updateActiveLangButton();
      }
    });
  });

  // Initial call to set correct button active state on render
  updateActiveLangButton();
</script>

<style>
  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 28px 0; /* Extra vertical padding for Khmer vowel mark heights */
    transition: var(--transition-smooth);
    border-bottom: 1px solid transparent;
  }

  .main-header.scrolled {
    padding: 18px 0;
    background-color: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo {
    color: #FFFFFF;
    letter-spacing: 0.1em;
    position: relative;
    z-index: 1001;
    transition: var(--transition-smooth);
    display: inline-flex;
    align-items: center; /* Center heart icon and text vertically */
  }

  .main-header.scrolled .logo {
    color: var(--text-primary);
  }

  .main-header.menu-open .logo {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .logo:hover,
  .main-header.scrolled .logo:hover,
  .main-header.menu-open .logo:hover {
    color: var(--accent-red);
  }

  .logo-kh {
    font-family: var(--font-khmer-header);
    font-size: 1.3rem;
  }

  .logo span:not(.logo-kh) {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 500;
  }

  .heart-icon {
    color: var(--accent-red);
    margin: 0 10px; /* Generous space to prevent overlapping Khmer glyphs */
    display: inline-block;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #FFFFFF;
    transition: var(--transition-smooth);
    position: relative;
    padding: 6px 0;
    display: inline-block;
  }

  .main-header.scrolled .nav-link {
    color: var(--text-primary);
  }

  /* Khmer text specific styling in menu */
  .nav-link .lang-kh {
    font-family: var(--font-khmer-body);
    font-size: 0.88rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: var(--accent-red);
    transition: var(--transition-smooth);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-link:hover {
    color: var(--accent-red);
  }

  .btn-rsvp {
    display: inline-block;
    padding: 8px 18px !important;
    border: 1px solid #FFFFFF;
    border-radius: 20px;
    color: #FFFFFF;
    background-color: transparent;
    transition: var(--transition-smooth);
  }

  .main-header.scrolled .btn-rsvp {
    border: 1px solid var(--accent-red);
    color: var(--accent-red);
  }

  .btn-rsvp::after {
    display: none;
  }

  .btn-rsvp:hover {
    background-color: #FFFFFF;
    color: var(--text-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.2);
  }

  .main-header.scrolled .btn-rsvp:hover {
    background-color: var(--accent-red);
    color: var(--bg-primary);
    box-shadow: 0 4px 12px rgba(139, 30, 34, 0.25);
  }

  /* Language Switcher Styling */
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 4px 12px;
    border-radius: 20px;
  }

  .main-header.scrolled .lang-switcher {
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid var(--border-color);
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    transition: var(--transition-smooth);
    padding: 2px 6px;
    line-height: 1;
  }

  .main-header.scrolled .lang-btn {
    color: var(--text-secondary);
  }

  .lang-btn[data-set-lang="kh"] {
    font-family: var(--font-khmer-body);
    font-size: 0.78rem;
    padding: 2px 4px;
  }

  .lang-btn:hover {
    color: #FFFFFF;
  }

  .main-header.scrolled .lang-btn:hover {
    color: var(--accent-red);
  }

  .lang-btn.active {
    color: #FFFFFF;
    font-weight: 700;
  }

  .main-header.scrolled .lang-btn.active {
    color: var(--accent-red);
  }

  .lang-divider {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .main-header.scrolled .lang-divider {
    color: var(--border-color);
  }

  /* Mobile Toggle */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 1001;
  }

  .nav-toggle .bar {
    display: block;
    width: 24px;
    height: 2px;
    margin: 5px 0;
    background-color: #FFFFFF;
    transition: var(--transition-smooth);
  }

  .main-header.scrolled .nav-toggle .bar,
  .main-header.menu-open .nav-toggle .bar {
    background-color: var(--text-primary);
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .nav-list {
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .header-container {
      justify-content: flex-end;
    }

    .nav-toggle {
      display: block;
    }

    .nav-menu {
      position: fixed;
      top: 0;
      right: -100%;
      width: 100%;
      height: 100vh;
      background-color: var(--bg-primary);
      display: flex;
      justify-content: center;
      align-items: center;
      transition: var(--transition-smooth);
      z-index: 1000;
    }

    .nav-menu.active {
      right: 0;
    }

    .nav-list {
      flex-direction: column;
      gap: 36px;
      text-align: center;
    }

    .nav-link {
      font-size: 1.15rem;
      color: var(--text-primary); /* Mobile menu links should always be dark */
    }

    .nav-link .lang-kh {
      font-size: 1.25rem;
    }

    .btn-rsvp {
      font-size: 1.15rem;
      padding: 10px 24px !important;
      color: var(--accent-red);
      border-color: var(--accent-red);
    }
    
    .btn-rsvp:hover {
      background-color: var(--accent-red);
      color: var(--bg-primary);
    }

    .lang-switcher-item {
      margin-top: 10px;
    }

    .lang-switcher {
      padding: 6px 16px;
      background: rgba(212, 175, 55, 0.08);
      border: 1px solid var(--border-color);
    }

    .lang-btn {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }
    
    .lang-btn:hover {
      color: var(--accent-red);
    }
    
    .lang-btn.active {
      color: var(--accent-red);
    }
    
    .lang-divider {
      color: var(--border-color);
    }

    .lang-btn[data-set-lang="kh"] {
      font-size: 0.95rem;
    }

    /* Burger Menu Animation */
    .nav-toggle.active .bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle.active .bar:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle.active .bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
