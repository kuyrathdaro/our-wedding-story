---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import Gallery from '../components/Gallery.astro';
import Details from '../components/Details.astro';
import ThankYou from '../components/ThankYou.astro';
import RSVP from '../components/RSVP.astro';
---

<Layout>
	<Navbar />
	<main>
		<Hero />
		<Timeline />
		<Gallery />
		<Details />
		<ThankYou />
		<RSVP />
	</main>
	
	<footer class="wedding-footer">
		<div class="footer-content">
			<p class="footer-copyright">
				<span class="lang-kh">&copy; ២០២៦ ដារ៉ូ និង កូនក្រមុំ។ រៀបចំឡើងដោយសេចក្តីស្រឡាញ់។</span>
				<span class="lang-en">&copy; 2026 Daro and Bride. Made with love.</span>
			</p>
		</div>
	</footer>
</Layout>

<style>
	.wedding-footer {
		background-color: transparent;
		padding: 40px 24px;
		text-align: center;
		position: relative;
	}

	.footer-content {
		max-width: 600px;
		margin: 0 auto;
		animation: fadeIn 1s ease forwards;
	}

	.footer-initials {
		font-family: var(--font-serif);
		font-size: 2.5rem;
		color: var(--accent-gold);
		letter-spacing: 0.15em;
		margin-bottom: 24px;
	}

	.footer-initials .logo-kh {
		font-family: var(--font-khmer-header);
		font-size: 1.8rem;
		letter-spacing: 0.05em;
		font-weight: normal;
	}

	.heart-icon {
		color: var(--accent-red);
		margin: 0 10px; /* Spaced out heart to prevent Khmer character overlapping */
		display: inline-block;
	}

	.footer-copyright {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-secondary);
	}

	.footer-copyright span.lang-kh {
		font-family: var(--font-khmer-body);
		font-size: 0.8rem;
		text-transform: none;
		letter-spacing: 0;
	}
</style>
