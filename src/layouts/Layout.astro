<!doctype html>
<html lang="kh" data-lang="kh">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Daro and Bride</title>
		
		<!-- Prevent Flash of Untranslated Language Preference -->
		<script is:inline>
			const savedLang = localStorage.getItem('wedding-lang') || 'kh';
			document.documentElement.setAttribute('data-lang', savedLang);
		</script>
		<style is:inline>
			html[data-lang="en"] .lang-kh { display: none !important; }
			html[data-lang="kh"] .lang-en { display: none !important; }
		</style>

		<!-- Google Fonts: Cormorant Garamond, Montserrat, Moul, & Kantumruy Pro -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Moul&family=Kantumruy+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-primary: #FFFFFF; /* Pure White for maximum clarity */
		--bg-secondary: #F8F9FA; /* Crisp light gray-white for contrast sections */
		--bg-glass: rgba(255, 255, 255, 0.9); /* Clear frosted glass */
		--text-primary: #111111; /* Near black for optimal readability */
		--text-secondary: #444444; /* Dark gray for secondary text */
		
		/* Refined Elegant Wedding Palette */
		--accent-gold: #B8860B; /* Deeper, richer Dark Goldenrod for better contrast against white */
		--accent-gold-rgb: 184, 134, 11;
		--accent-gold-hover: #996515;
		--accent-red: #8B0000; /* Deep elegant red */
		--accent-red-hover: #660000;
		--border-color: rgba(184, 134, 11, 0.2);
		
		--font-serif: 'Cormorant Garamond', Georgia, serif;
		--font-sans: 'Montserrat', system-ui, -apple-system, sans-serif;
		--font-khmer-header: 'Moul', cursive, serif;
		--font-khmer-body: 'Kantumruy Pro', 'Montserrat', sans-serif;
		--transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		--max-width: 1200px;
	}

	html {
		scroll-behavior: smooth;
		box-sizing: border-box;
	}

	*, *:before, *:after {
		box-sizing: inherit;
	}

	body {
		margin: 0;
		font-family: var(--font-sans);
		background-color: var(--bg-primary);
		color: var(--text-primary);
		line-height: 1.6;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		transition: background-color 0.4s ease, color 0.4s ease;
	}



	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-serif);
		font-weight: 500;
		margin: 0;
		color: var(--accent-red); /* Royal crimson for traditional Khmer headers */
		letter-spacing: 0.02em;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* CSS Language Switcher Visibility Rules managed in head */

	/* Dynamic Fonts depending on selected language */
	html[data-lang="kh"] body {
		font-family: var(--font-khmer-body);
		line-height: 1.85; /* Spacious line height for Khmer script */
	}
	
	html[data-lang="kh"] h1,
	html[data-lang="kh"] h2,
	html[data-lang="kh"] .logo-kh {
		font-family: var(--font-khmer-header);
		font-weight: normal;
	}

	html[data-lang="kh"] h3,
	html[data-lang="kh"] h4,
	html[data-lang="kh"] h5,
	html[data-lang="kh"] h6,
	html[data-lang="kh"] .card-title-khmer,
	html[data-lang="kh"] .event-khmer {
		font-family: var(--font-khmer-body);
		font-weight: 700;
	}

	/* Reset letter-spacing on Khmer text to prevent disjointed script */
	html[data-lang="kh"] * {
		letter-spacing: 0 !important;
	}

	/* Traditional Divider ornament style */
	.khmer-ornament-divider {
		margin: 16px auto 28px auto;
		display: flex;
		justify-content: center;
	}

	/* Simple reveal animations styles */
	.reveal-on-scroll {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.reveal-on-scroll.active {
		opacity: 1;
		transform: translateY(0);
	}

	/* Scrollbar styling */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: var(--bg-primary);
	}
	::-webkit-scrollbar-thumb {
		background: var(--accent-gold);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--accent-gold-hover);
	}
</style>
